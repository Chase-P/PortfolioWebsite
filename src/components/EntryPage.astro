---
// One scrollable, docs-style page per project/leadership entry.
import Base from '../layouts/Base.astro';
import Blocks from './Blocks.astro';
import ProjectVisual from './ProjectVisual.astro';
import type { Entry } from '../data/types';
import { md, url, libraryPhotos } from '../lib';

interface Props {
  entry: Entry;
  base: string;
  baseLabel: string;
  all: Entry[];
}
const { entry: e, base, baseLabel, all } = Astro.props;
const i = all.findIndex((x) => x.slug === e.slug);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const n = (k: number) => String(k + 1).padStart(2, '0');
const lib = libraryPhotos(e.slug);
---

<Base title={e.title} description={e.tagline}>
  <div class="container">
    <header class="page-head head">
      <div class="crumbs">
        <a href={url(`${base}/`)}>{baseLabel}</a><span>/</span><span>{e.title}</span>
      </div>
      <h1>{e.title}</h1>
      <p class="lede">{e.tagline}</p>
      <div class="facts">
        <span><i>Category</i>{e.category}</span>
        <span><i>When</i>{e.year}</span>
        {e.role && <span><i>Role</i>{e.role}</span>}
        {e.status && <span><i>Status</i>{e.status}</span>}
        {e.links?.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      </div>
    </header>

    <div class:list={['layout', { single: e.pages.length === 0 }]}>
      {
        e.pages.length > 0 && (
          <aside class="side">
            <span class="label">On this page</span>
            <nav id="toc">
              <a href="#overview" data-t="overview">Overview</a>
              {e.pages.map((p, k) => (
                <a href={`#${p.slug}`} data-t={p.slug}>
                  <span class="num">{n(k)}</span>
                  {p.title}
                </a>
              ))}
            </nav>
          </aside>
        )
      }

      <article class="content">
        <section id="overview" class="doc">
          <div class="hero shot">
            {e.cover ? <img src={url(e.cover)} alt={e.title} /> : e.viz && <ProjectVisual kind={e.viz} />}
          </div>
          {e.metrics && <Blocks blocks={[{ t: 'stats', items: e.metrics }]} />}
          <div class="intro">{e.intro.map((p) => <p set:html={md(p)} />)}</div>
          {e.overview && <Blocks blocks={e.overview} />}
          {lib.length > 0 && <Blocks blocks={[{ t: 'gallery', items: lib }]} />}
          <div class="stack">
            <span class="label">Built with</span>
            <div class="tags">{e.stack.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </section>

        {
          e.pages.map((p, k) => (
            <section id={p.slug} class="doc">
              <div class="sh">
                <span class="num big">{n(k)}</span>
                <div>
                  <h2>
                    <a href={`#${p.slug}`}>{p.title}</a>
                  </h2>
                  <p class="muted">{p.summary}</p>
                </div>
              </div>
              <Blocks blocks={p.blocks} />
            </section>
          ))
        }

        <nav class="pager">
          <a href={url(`${base}/${prev.slug}/`)} class="card"><span class="label">← Previous</span><b>{prev.title}</b></a>
          <a href={url(`${base}/${next.slug}/`)} class="card right"><span class="label">Next →</span><b>{next.title}</b></a>
        </nav>
      </article>
    </div>
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc a')];
  if (links.length) {
    const secs = links.map((a) => document.getElementById(a.dataset.t!)!);
    const update = () => {
      let cur = secs[0];
      for (const s of secs) if (s.getBoundingClientRect().top < 260) cur = s;
      if (innerHeight + scrollY >= document.body.scrollHeight - 4) cur = secs[secs.length - 1];
      links.forEach((a) => a.classList.toggle('on', a.dataset.t === cur.id));
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .head h1 {
    max-width: 22ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    align-items: center;
    margin-top: 22px;
    font-size: 0.9rem;
  }
  .facts span {
    display: flex;
    flex-direction: column;
  }
  .facts i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--faint);
  }
  .layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .layout.single {
    grid-template-columns: minmax(0, 1fr);
    max-width: 860px;
  }
  .side {
    position: sticky;
    top: 84px;
    min-width: 0;
  }
  .side nav {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    border-left: 1px solid var(--border);
  }
  .side a {
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--muted);
    padding: 7px 0 7px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    display: flex;
    gap: 8px;
  }
  .side a:hover {
    color: var(--text);
  }
  .side a.on {
    color: var(--text);
    border-left-color: var(--accent);
    font-weight: 500;
  }
  .num {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    padding-top: 2px;
  }
  .content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .doc {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-bottom: 56px;
    scroll-margin-top: 80px;
  }
  .doc + .doc {
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .sh {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }
  .num.big {
    font-size: 0.95rem;
    color: var(--accent);
  }
  .sh h2 a {
    text-decoration: none;
  }
  .sh h2 a:hover {
    color: var(--accent);
  }
  .sh p {
    margin: 6px 0 0;
  }
  .hero {
    background: var(--bg-2);
  }
  .intro p {
    font-size: 1.08rem;
    max-width: 70ch;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager a {
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pager .right {
    text-align: right;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .side {
      top: 60px;
      z-index: 5;
      background: var(--bg);
      padding-top: 8px;
    }
    .side .label {
      display: none;
    }
    .side nav {
      flex-direction: row;
      overflow-x: auto;
      border-left: 0;
      border-bottom: 1px solid var(--border);
      margin: 0;
    }
    .side a {
      white-space: nowrap;
      border-left: 0;
      border-bottom: 2px solid transparent;
      padding: 8px 12px;
      margin: 0 0 -1px;
    }
    .side a.on {
      border-bottom-color: var(--accent);
    }
    .side .num {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
