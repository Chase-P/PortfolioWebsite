---
import Base from '../layouts/Base.astro';
import PursuitSim from '../components/PursuitSim.astro';
import EntryCard from '../components/EntryCard.astro';
import { profile, timeline, education } from '../data/profile';
import { projects } from '../data/projects';
import { work, leadership } from '../data/experience';
import { url, hasFile, libraryPhotos, creditFor } from '../lib';

const featured = projects.filter((p) => p.featured).slice(0, 6);
const photo = hasFile(profile.photo);
const lib = libraryPhotos();
---

<Base>
  <section class="hero container">
    <div class="who">
      <div class="portrait">
        {photo ? <img src={url(profile.photo)} alt={profile.fullName} width="200" height="200" /> : <span>CP</span>}
      </div>
      <div>
        <h1>Hi, I’m Chase. I’m a software developer.</h1>
        <p class="lede">Take a look at my projects and experience. I’ll let the work speak for itself.</p>
        <nav class="cta" aria-label="Primary actions">
          <a class="btn primary" href="#projects">Projects</a>
          <a class="btn" href="#experience">Experience</a>
          <a class="btn" href={url(profile.resume)} target="_blank" rel="noopener">Resume (PDF)</a>
        </nav>
        <p class="elsewhere">
          <a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="container" aria-label="Background">
    <ul class="bg">
      <li><span class="label">Education</span><b>{education.degree}, Georgia Tech</b><span class="muted">{education.grad}</span></li>
      <li><span class="label">Experience</span><b>{work[0].category}, {work[0].title}</b><span class="muted">{work[0].year}</span></li>
      <li><span class="label">Interests</span><b>Developer tooling, AI agents, robotics</b><span class="muted">Full-stack apps and embedded control</span></li>
    </ul>
  </section>

  <section class="section container" id="projects">
    <div class="section-head"><h2>Projects</h2><a href={url('projects/')}>All {projects.length} projects →</a></div>
    <div class="grid">{featured.map((p) => <EntryCard entry={p} base="projects" />)}</div>
  </section>

  <section class="section container" id="experience">
    <div class="section-head"><h2>Experience</h2><a href={url('experience/')}>All experience →</a></div>
    <div class="xp">
      {
        work.map((e) => (
          <a href={url(`experience/${e.slug}/`)} class="card xcard">
            <span class="label">Professional · {e.year}</span>
            <b>{e.title} <span class="muted">· {e.category}</span></b>
            <span class="muted">{e.tagline}</span>
            <span class="arrow">Read more →</span>
          </a>
        ))
      }
    </div>
    <h3 class="sub">Robotics &amp; leadership</h3>
    <ul class="lead">
      {
        leadership.map((e) => (
          <li><a href={url(`experience/${e.slug}/`)}>{e.title}</a><span class="muted">{e.category} · {e.year}</span></li>
        ))
      }
    </ul>
  </section>

  <section class="section container sim-wrap">
    <div>
      <span class="label">Try it</span>
      <h2>Pure pursuit, live</h2>
      <p class="muted">
        This is the path-following algorithm from my competition robots, running in your browser. The robot chases a
        point one lookahead distance ahead on the path and steers along the arc that reaches it (κ = 2x / L²). Click it
        to generate a new path. <a href={url('projects/odometry-pure-pursuit/')}>How it works →</a>
      </p>
    </div>
    <PursuitSim />
  </section>

  <section class="section container">
    <a href={url('georgia-tech/')} class="card gt">
      <figure class="gt-img">
        <img src={url(education.image)} alt="Tech Tower at Georgia Tech" loading="lazy" />
        <figcaption>{creditFor(education.image)}</figcaption>
      </figure>
      <div class="gt-body">
        <span class="label">Education · {education.grad}</span>
        <h2>{education.school}</h2>
        <p class="deg">{education.degree} · {education.place}</p>
        <ul>
          {education.threads.map((t) => <li><b>{t.name}</b><span class="muted">{t.note}</span></li>)}
        </ul>
        <span class="arrow">More about Georgia Tech →</span>
      </div>
    </a>
  </section>

  <section class="section container">
    <div class="section-head"><h2>Timeline</h2></div>
    <ol class="tl">
      {timeline.map((t) => <li><span class="y">{t.year}</span><span>{t.text}</span></li>)}
    </ol>
  </section>

  {
    lib.length > 0 && (
      <section class="section container">
        <div class="section-head"><h2>Photos</h2></div>
        <div class="photos">
          {lib.map((p) => (
            <figure>
              <img src={url(p.src)} alt={p.caption} loading="lazy" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

</Base>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 40px;
  }
  .who {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 44px;
    align-items: center;
  }
  .portrait {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--accent);
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--border);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait span {
    font-family: var(--serif);
    font-size: 4rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
    margin: 8px 0 14px;
  }
  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 58ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 16px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .elsewhere a:hover {
    color: var(--accent);
  }
  .bg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .bg li {
    padding: 18px 20px 18px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bg li + li {
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }
  .bg .muted {
    font-size: 0.86rem;
  }
  .xp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .xcard {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .xcard b {
    font-size: 1.1rem;
  }
  .xcard .arrow {
    margin-top: auto;
    color: var(--accent);
    font-size: 0.88rem;
  }
  .sub {
    margin: 32px 0 10px;
    font-size: 1rem;
  }
  .lead {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 4px 24px;
  }
  .lead li {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .lead a {
    font-weight: 600;
    text-decoration: none;
  }
  .lead a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lead .muted {
    font-size: 0.82rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .stats div {
    padding: 22px 20px 22px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stats div + div {
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }
  .stats b {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--accent);
  }
  .stats span {
    font-size: 0.84rem;
    color: var(--muted);
  }
  .about {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
  }
  .gt {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    overflow: hidden;
  }
  .gt-img {
    position: relative;
    min-height: 320px;
  }
  .gt-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gt-img figcaption {
    position: absolute;
    bottom: 8px;
    left: 10px;
    margin: 0;
    font-size: 0.68rem;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }
  .gt-body {
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .deg {
    margin: 0;
    color: var(--accent);
    font-weight: 500;
  }
  .gt-body ul {
    list-style: none;
    margin: 6px 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .gt-body li {
    display: flex;
    flex-direction: column;
    font-size: 0.94rem;
  }
  .gt-body .arrow {
    margin-top: auto;
  }
  .story p {
    font-size: 1.06rem;
    max-width: 70ch;
  }
  .now {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 10px;
  }
  .now div {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .now div + div {
    border-left: 1px solid var(--border);
  }
  .now .muted {
    font-size: 0.84rem;
  }
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  .tl li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding: 10px 0 10px 22px;
    position: relative;
  }
  .tl li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .y {
    font-family: var(--mono);
    font-weight: 500;
    color: var(--accent);
  }
  .guide {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 12px;
  }
  .gcard {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .gcard b {
    font-size: 1.1rem;
  }
  .gcard .muted {
    font-size: 0.88rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .photos {
    columns: 3 260px;
    gap: 12px;
  }
  .photos figure {
    break-inside: avoid;
    margin-bottom: 12px;
  }
  .photos img {
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .sim-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .sim-wrap a {
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .who {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .portrait {
      width: 140px;
      height: 140px;
    }
    .gt,
    .sim-wrap,
    .now {
      grid-template-columns: 1fr;
    }
    .now div + div {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 16px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .elsewhere a:hover {
    color: var(--accent);
  }
  .bg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .bg li {
    padding: 18px 20px 18px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bg li + li {
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }
  .bg .muted {
    font-size: 0.86rem;
  }
  .xp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .xcard {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .xcard b {
    font-size: 1.1rem;
  }
  .xcard .arrow {
    margin-top: auto;
    color: var(--accent);
    font-size: 0.88rem;
  }
  .sub {
    margin: 32px 0 10px;
    font-size: 1rem;
  }
  .lead {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 4px 24px;
  }
  .lead li {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .lead a {
    font-weight: 600;
    text-decoration: none;
  }
  .lead a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lead .muted {
    font-size: 0.82rem;
  }
  .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
</style>
