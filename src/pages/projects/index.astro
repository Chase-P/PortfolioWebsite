---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { projects, categories } from '../../data/projects';

const pageCount = projects.reduce((n, p) => n + p.pages.length, 0);
---

<Base title="Projects" description="Everything I have built: full-stack platforms, robotics, AI systems and research tools.">
  <div class="container">
    <header class="page-head">
      <span class="label">{projects.length} projects · {pageCount} documented sections</span>
      <h1>Projects</h1>
    </header>

    <div class="filters" role="group" aria-label="Filter projects by category">
      {categories.map((c, i) => <button type="button" class:list={{ on: i === 0 }} aria-pressed={i === 0 ? 'true' : 'false'} data-f={c}>{c}</button>)}
    </div>
    <p class="count muted" aria-live="polite"></p>

    <div class="grid">
      {projects.map((p) => <EntryCard entry={p} base="projects" />)}
    </div>
  </div>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
  }
  .filters button {
    font: inherit;
    font-size: 0.85rem;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .filters button.on {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .count {
    margin: -12px 0 16px;
    font-size: 0.85rem;
    min-height: 1em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const count = document.querySelector('.count');
  const cards = document.querySelectorAll<HTMLElement>('.grid > a');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => {
        x.classList.toggle('on', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      const f = b.dataset.f;
      let n = 0;
      cards.forEach((c) => {
        const show = f === 'All' || c.dataset.cat === f;
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (count) count.textContent = f === 'All' ? '' : `${n} ${f} project${n === 1 ? '' : 's'}`;
    })
  );
</script>
