---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { projects, categories } from '../../data/projects';

const pageCount = projects.reduce((n, p) => n + p.pages.length, 0);
---

<Base title="Projects" description="Everything I have built: full-stack platforms, robotics, AI systems and research tools.">
  <div class="container">
    <header class="page-head">
      <span class="label">{projects.length} projects · {pageCount} documented sections</span>
      <h1>Projects</h1>
      <p class="lede">
        Full-stack platforms, robot autonomy, AI agent infrastructure and quantitative research. Each project reads like its docs: an
        overview and documented sections on its architecture and the hard problems.
      </p>
    </header>

    <div class="filters" role="tablist">
      {categories.map((c, i) => <button class:list={{ on: i === 0 }} data-f={c}>{c}</button>)}
    </div>

    <div class="grid">
      {projects.map((p) => <EntryCard entry={p} base="projects" />)}
    </div>
  </div>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
  }
  .filters button {
    font: inherit;
    font-size: 0.85rem;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .filters button.on {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('.grid > a');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('on', x === b));
      const f = b.dataset.f;
      cards.forEach((c) => (c.style.display = f === 'All' || c.dataset.cat === f ? '' : 'none'));
    })
  );
</script>
