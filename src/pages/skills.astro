---
import Base from '../layouts/Base.astro';
import { skillGroups } from '../data/skills';
import { awards } from '../data/profile';
import { projects } from '../data/projects';
import { allExperience } from '../data/experience';
import { url } from '../lib';

type Use = { title: string; href: string; tagline: string; cover?: string; kind: string };
const entries = [
  ...projects.map((e) => ({ e, base: 'projects', kind: 'Project' })),
  ...allExperience.map((e) => ({ e, base: 'experience', kind: 'Experience' })),
];
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9+#]/g, '');
const initials = (s: string) => s.replace(/[^A-Za-z0-9+# ]/g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();

// Where each skill shows up: explicit links plus any page whose stack mentions it.
const usesFor = (name: string, explicit: string[] = []): Use[] => {
  const key = norm(name.split(/[/(&]/)[0]);
  return entries
    .filter(({ e }) => explicit.includes(e.slug) || (key.length > 1 && e.stack.some((t) => norm(t).includes(key) || key.includes(norm(t)) && norm(t).length > 2)))
    .map(({ e, base, kind }) => ({ title: e.title, href: url(`${base}/${e.slug}/`), tagline: e.tagline, cover: e.cover ? url(e.cover) : undefined, kind }));
};
const slugify = (s: string) =>
  s.toLowerCase().replace(/\+/g, 'p').replace(/#/g, 'sharp').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const groups = skillGroups.map((g) => ({
  ...g,
  items: g.items.map((s) => ({ ...s, id: `skill-${slugify(s.name)}`, uses: usesFor(s.name, s.projects) })),
}));

// Data for the skill search: each skill with the pages that use it, and each page once.
const finderSkills = groups.flatMap((g) => g.items.filter((s) => s.uses.length).map((s) => ({ name: s.name, hrefs: s.uses.map((u) => u.href) })));
const finderPages = Object.fromEntries(
  entries.map(({ e, base, kind }) => [url(`${base}/${e.slug}/`), { title: e.title, kind, tagline: e.tagline }])
);
---

<Base title="Skills" description="Languages, robotics, infrastructure and CAD, each linked to where I used it.">
  <div class="container">
    <header class="page-head">
      <span class="label">Toolbox</span>
      <h1>Skills</h1>
      <h2 class="finder-title">Looking for something specific?</h2>
      <p class="lede">
        Search my projects and experience by what you’re looking for. Add skills to narrow the results and find examples of how I’ve
        used them.
      </p>
      <form class="finder" role="search" aria-label="Search projects and experience by skill">
        <label for="finder-input" class="finder-label">Add a skill</label>
        <div class="finder-row">
          <input id="finder-input" list="finder-list" placeholder="e.g. Python" autocomplete="off" />
          <button type="submit" class="btn primary">Add</button>
          <button type="button" class="btn finder-reset" hidden>Clear all</button>
        </div>
        <datalist id="finder-list">{finderSkills.map((f) => <option value={f.name} />)}</datalist>
        <ul class="chips" aria-label="Selected skills"></ul>
        <p class="finder-status muted" aria-live="polite"></p>
        <ul class="finder-results"></ul>
      </form>
      <script type="application/json" id="finder-data" set:html={JSON.stringify({ skills: finderSkills, pages: finderPages })} />
      <p class="muted hint">Or browse below: click a skill, or its “View usage” link, to see where I’ve used it. Awards are at the bottom.</p>
      <div class="jump">
        {groups.map((g) => <a href={`#${g.group.replace(/\W+/g, '-').toLowerCase()}`}>{g.group}</a>)}
        <a href="#accolades" class="acc">Accolades</a>
      </div>
    </header>

    {
      groups.map((g) => (
        <section class="group" id={g.group.replace(/\W+/g, '-').toLowerCase()}>
          <div class="ghead">
            <h2>{g.group}</h2>
            {g.blurb && <p class="muted">{g.blurb}</p>}
          </div>
          <div class="skills">
            {g.items.map((s) => (
              <div class="card skill" id={s.id}>
                <button type="button" class="open" aria-haspopup="dialog">
                  <span class="top">
                    {s.logo ? <span class="logo" style={`--src: url('${url(`img/logos/${s.logo}.svg`)}')`} /> : <span class="logo text">{initials(s.name)}</span>}
                    <b>{s.name}</b>
                    {s.uses.length > 0 && <span class="count" title={`Used in ${s.uses.length} places`}>{s.uses.length}</span>}
                  </span>
                  {s.note && <span class="note">{s.note}</span>}
                </button>
                {s.uses.length > 0 && <a class="view" href={`#${s.id}`}>View usage</a>}
                <template>
                  <div class="m-head">
                    {s.logo ? <span class="logo big" style={`--src: url('${url(`img/logos/${s.logo}.svg`)}')`} /> : <span class="logo text big">{initials(s.name)}</span>}
                    <div><span class="label">{g.group}</span><h3 id="m-title">{s.name}</h3>{s.note && <p class="muted">{s.note}</p>}</div>
                  </div>
                  <span class="label">{s.uses.length ? `Used in ${s.uses.length} place${s.uses.length > 1 ? 's' : ''}` : 'Where I use it'}</span>
                  {s.uses.length ? (
                    <div class="uses">
                      {s.uses.map((u) => (
                        <a href={u.href} class="use">
                          {u.cover ? <img src={u.cover} alt="" /> : <span class="ph" />}
                          <span class="ut">
                            <span class="label">{u.kind}</span>
                            <b>{u.title}</b>
                            <span class="muted">{u.tagline}</span>
                          </span>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <p class="muted">Used across coursework and day-to-day development. Ask me about it!</p>
                  )}
                </template>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="group" id="accolades">
      <div class="ghead">
        <h2>Accolades</h2>
        <p class="muted">60+ awards across six years of competition, plus academic recognition.</p>
      </div>
      <div class="awards">
        {
          awards.map((a) => (
            <div class="card tier">
              <span class="label">{a.tier}</span>
              <ul>{a.items.map((i) => <li><b>{i.name}</b><span class="muted">{i.note}</span></li>)}</ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <dialog id="skill-modal" aria-labelledby="m-title">
    <button class="close" aria-label="Close">×</button>
    <div class="m-body"></div>
  </dialog>
</Base>

<script>
  // ── Skill popup ──
  const dlg = document.getElementById('skill-modal') as HTMLDialogElement;
  const body = dlg.querySelector('.m-body')!;
  let opener: HTMLElement | null = null;

  const openSkill = (card: HTMLElement, from: HTMLElement | null) => {
    body.innerHTML = '';
    body.append((card.querySelector('template') as HTMLTemplateElement).content.cloneNode(true));
    opener = from;
    if (!dlg.open) dlg.showModal();
  };

  document.querySelectorAll<HTMLElement>('.skill').forEach((card) => {
    card.querySelector('.open')!.addEventListener('click', (e) => openSkill(card, e.currentTarget as HTMLElement));
    card.querySelector('.view')?.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${card.id}`);
      openSkill(card, e.currentTarget as HTMLElement);
    });
  });

  dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
  dlg.addEventListener('close', () => {
    if (location.hash.startsWith('#skill-')) history.replaceState(null, '', location.pathname + location.search);
    opener?.focus();
  });

  // Deep link: skills/#skill-python opens that skill's popup.
  const fromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const card = id.startsWith('skill-') ? document.getElementById(id) : null;
    if (card?.classList.contains('skill') && card.querySelector('.view')) openSkill(card, card.querySelector('.open'));
  };
  window.addEventListener('hashchange', fromHash);
  fromHash();

  // ── Skill search ── Multiple skills use AND matching: a result must use every selected skill.
  type Page = { title: string; kind: string; tagline: string };
  const data = JSON.parse(document.getElementById('finder-data')!.textContent!) as {
    skills: { name: string; hrefs: string[] }[];
    pages: Record<string, Page>;
  };
  const form = document.querySelector<HTMLFormElement>('.finder')!;
  const input = form.querySelector<HTMLInputElement>('#finder-input')!;
  const chips = form.querySelector('.chips')!;
  const status = form.querySelector('.finder-status')!;
  const results = form.querySelector('.finder-results')!;
  const reset = form.querySelector<HTMLButtonElement>('.finder-reset')!;
  const selected: string[] = [];
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const find = (q: string) => {
    const k = q.trim().toLowerCase();
    return data.skills.find((s) => s.name.toLowerCase() === k) ?? data.skills.find((s) => s.name.toLowerCase().startsWith(k));
  };

  const render = () => {
    chips.innerHTML = selected
      .map((n) => `<li><button type="button" data-n="${esc(n)}" aria-label="Remove ${esc(n)}">${esc(n)} <span aria-hidden="true">×</span></button></li>`)
      .join('');
    reset.hidden = selected.length === 0;
    if (!selected.length) {
      status.textContent = '';
      results.innerHTML = '';
      return;
    }
    const sets = selected.map((n) => new Set(data.skills.find((s) => s.name === n)!.hrefs));
    const hrefs = [...sets[0]].filter((h) => sets.every((set) => set.has(h)));
    const what = selected.length > 1 ? `using all of: ${selected.join(', ')}` : `using ${selected[0]}`;
    status.textContent = hrefs.length
      ? `${hrefs.length} result${hrefs.length === 1 ? '' : 's'} ${what}.`
      : 'Nothing uses all of these together yet. Remove a skill to widen the search.';
    results.innerHTML = hrefs
      .map((h) => {
        const p = data.pages[h];
        return `<li><a href="${h}"><span class="label">${esc(p.kind)}</span><b>${esc(p.title)}</b><span class="muted">${esc(p.tagline)}</span></a></li>`;
      })
      .join('');
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    const s = find(q);
    if (!s) {
      status.textContent = `Nothing on the site lists “${q}” yet. Try one of the suggestions.`;
      return;
    }
    if (!selected.includes(s.name)) selected.push(s.name);
    input.value = '';
    render();
  });
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-n]');
    if (!b) return;
    selected.splice(selected.indexOf(b.dataset.n!), 1);
    render();
    input.focus();
  });
  reset.addEventListener('click', () => {
    selected.length = 0;
    render();
    input.focus();
  });
</script>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  .jump a {
    font-size: 0.82rem;
    text-decoration: none;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface);
  }
  .jump .acc {
    border-color: var(--accent);
    color: var(--accent);
  }
  .group {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
  }
  .ghead h2 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }
  .ghead p {
    font-size: 0.9rem;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 10px;
  }
  .skill {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    transition: border-color 0.15s;
  }
  .skill:hover,
  .skill:focus-within {
    border-color: var(--accent);
  }
  .open {
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
  }
  .view {
    margin-top: auto;
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .view:hover {
    color: var(--accent);
  }
  .finder-title {
    font-size: 1.3rem;
    margin: 20px 0 4px;
  }
  .hint {
    font-size: 0.88rem;
    margin-top: 18px;
  }
  .finder {
    margin-top: 14px;
    max-width: 720px;
  }
  .finder-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .finder-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .finder input {
    flex: 1 1 220px;
    font: inherit;
    padding: 8px 12px;
    min-height: 42px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips :global(button) {
    font: inherit;
    font-size: 0.82rem;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--text);
    cursor: pointer;
  }
  .finder-status {
    font-size: 0.88rem;
    margin: 8px 0;
  }
  .finder-results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .finder-results :global(a) {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .finder-results :global(a:hover) {
    border-color: var(--accent);
  }
  .finder-results :global(.muted) {
    font-size: 0.82rem;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .top b {
    font-size: 0.94rem;
    font-weight: 600;
    flex: 1;
  }
  .count {
    font-family: var(--mono);
    font-size: 0.7rem;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 1px 7px;
    border-radius: 999px;
  }
  .logo {
    width: 26px;
    height: 26px;
    flex: none;
    background: var(--text);
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }
  .logo.text {
    -webkit-mask: none;
    mask: none;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--muted);
  }
  .note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  dialog {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0;
    width: min(640px, calc(100vw - 32px));
    max-height: 85vh;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
  }
  dialog::backdrop {
    background: rgba(10, 15, 25, 0.45);
    backdrop-filter: blur(3px);
  }
  .close {
    position: absolute;
    top: 10px;
    right: 12px;
    border: 0;
    background: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
  }
  .m-body {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .m-body :global(.m-head) {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .m-body :global(.logo.big) {
    width: 46px;
    height: 46px;
  }
  .m-body :global(h3) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.6rem;
  }
  .m-body :global(.m-head p) {
    margin: 2px 0 0;
    font-size: 0.9rem;
  }
  .m-body :global(.uses) {
    display: grid;
    gap: 10px;
  }
  .m-body :global(.use) {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
  }
  .m-body :global(.use:hover) {
    border-color: var(--accent);
  }
  .m-body :global(.use img),
  .m-body :global(.use .ph) {
    width: 120px;
    height: 76px;
    object-fit: cover;
    object-position: top left;
    border-radius: 6px;
    background: var(--bg-2);
  }
  .m-body :global(.ut) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.88rem;
  }
  .m-body :global(.ut .muted) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.82rem;
  }
  .awards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
  }
  .tier {
    padding: 18px 20px;
  }
  .tier ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }
  .tier li {
    display: flex;
    flex-direction: column;
    font-size: 0.92rem;
  }
  .tier li .muted {
    font-size: 0.8rem;
  }
  @media (max-width: 820px) {
    .group {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
