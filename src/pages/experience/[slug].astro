---
import EntryPage from '../../components/EntryPage.astro';
import { allExperience } from '../../data/experience';

export function getStaticPaths() {
  return allExperience.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<EntryPage entry={entry} base="experience" baseLabel="Experience" all={allExperience} />
